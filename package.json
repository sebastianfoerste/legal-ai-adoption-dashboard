{
  "name": "legal-ai-adoption-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
